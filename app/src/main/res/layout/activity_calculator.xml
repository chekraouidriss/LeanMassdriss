<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ══ HEADER BLEU ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1976D2"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Ligne titre + bouton logout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <!-- Titre app -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LeanMass"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:letterSpacing="0.03" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculateur de masse maigre"
                        android:textSize="12sp"
                        android:textColor="#B3E5FC"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Bouton Déconnexion -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quitter"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="@android:color/white"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="1dp"
                    app:cornerRadius="20dp" />

            </LinearLayout>

            <!-- Sous-ligne : méthode utilisée -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Méthode de Boer · Résultats instantanés"
                android:textSize="11sp"
                android:textColor="#90CAF9"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- ══ CONTENU PRINCIPAL ════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp">

            <!-- ── CARD FORMULAIRE ─────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#E8EAF6"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Titre section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOS DONNÉES"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="20dp" />

                    <!-- ── Genre (RadioGroup) ──────────────────── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Genre"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#424242"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="10dp" />

                    <RadioGroup
                        android:id="@+id/rgGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">

                        <!-- Homme -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardMale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#1976D2"
                            app:strokeWidth="2dp"
                            android:layout_marginEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="12dp">

                                <RadioButton
                                    android:id="@+id/rbMale"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:buttonTint="#1976D2"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="♂  Homme"
                                    android:textSize="14sp"
                                    android:textColor="#1976D2"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Femme -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardFemale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="10dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#E0E0E0"
                            app:strokeWidth="2dp"
                            android:layout_marginStart="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="12dp">

                                <RadioButton
                                    android:id="@+id/rbFemale"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="false"
                                    android:buttonTint="#E91E63"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="♀  Femme"
                                    android:textSize="14sp"
                                    android:textColor="#757575"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </RadioGroup>

                    <!-- ── Poids ───────────────────────────────── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Poids"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#424242"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWeight"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#1976D2"
                        app:hintEnabled="false"
                        app:suffixText="kg"
                        app:suffixTextColor="#1976D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ex : 70.5"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="16sp"
                            android:textColor="#212121"
                            android:textColorHint="#BDBDBD"
                            android:imeOptions="actionNext" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ── Taille ──────────────────────────────── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taille"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#424242"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilHeight"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#1976D2"
                        app:hintEnabled="false"
                        app:suffixText="cm"
                        app:suffixTextColor="#1976D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ex : 175"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:textSize="16sp"
                            android:textColor="#212121"
                            android:textColorHint="#BDBDBD"
                            android:imeOptions="actionDone" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BOUTON CALCULER ─────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CALCULER ET SAUVEGARDER"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="20dp"
                app:cornerRadius="14dp"
                app:backgroundTint="#1976D2"
                app:icon="@android:drawable/ic_menu_send"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                android:textColor="@android:color/white" />

            <!-- ── PROGRESS BAR ────────────────────────────────── -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="#1976D2"
                android:layout_marginBottom="16dp" />

            <!-- ══ CARD RÉSULTAT (masquée au départ) ═══════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <!-- Titre résultat -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RÉSULTAT"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#9E9E9E"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="16dp" />

                    <!-- Icône statut (✅ ou ⚠️) -->
                    <TextView
                        android:id="@+id/tvResultIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅"
                        android:textSize="48sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Valeur LBM -->
                    <TextView
                        android:id="@+id/tvLbmValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- kg"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2"
                        android:layout_marginBottom="6dp" />

                    <!-- Label "Masse maigre" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Masse maigre (LBM)"
                        android:textSize="13sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginBottom="20dp" />

                    <!-- Séparateur -->
                    <View
                        android:layout_width="60dp"
                        android:layout_height="2dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="20dp" />

                    <!-- Statut textuel -->
                    <TextView
                        android:id="@+id/tvResultStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Résultat satisfaisant"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:layout_marginBottom="8dp" />

                    <!-- Message détail -->
                    <TextView
                        android:id="@+id/tvResultDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Votre masse maigre est dans les normes."
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.4" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BOUTON HISTORIQUE ───────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToHistory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Voir l'historique des calculs"
                android:textSize="14sp"
                android:textColor="#1976D2"
                app:strokeColor="#1976D2"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconGravity="textStart"
                app:iconTint="#1976D2" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>